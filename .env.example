# Copy this file to .env.local and fill in the values. Never commit real keys.

# Supabase (Project Settings > API) — filled in during step 2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never use it in client components
SUPABASE_SERVICE_ROLE_KEY=
# Database connection string for migrations (Connect > Session pooler), password included
SUPABASE_DB_URL=

# AI: "mock" (no key needed) or "real" (calls the AI module)
WAYWAY_AI_MODE=mock
OPENROUTER_API_KEY=

# Google Maps Platform (map page). Never commit real keys.
# Browser key: restricted to http://localhost:3000/* and to the Maps JavaScript API only.
# It starts with NEXT_PUBLIC_, so Next.js sends it to the browser: that is why it must be restricted.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Google Maps Platform > Map management, JavaScript, Vector): needed for the numbered pins
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Server key: restricted to Places API (New) + Routes API. No NEXT_PUBLIC_ prefix = never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=
