# Copy this file to .env.local and fill in the values. Never commit real keys.

# Supabase (Project Settings > API) — filled in during step 2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: never use it in client components
SUPABASE_SERVICE_ROLE_KEY=
# Database connection string for migrations (Connect > Session pooler), password included
SUPABASE_DB_URL=

# AI: "mock" (no key needed) or "real" (calls the AI module)
WAYWAY_AI_MODE=mock
OPENROUTER_API_KEY=
